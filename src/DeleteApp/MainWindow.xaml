<Window x:Class="DeleteApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Rogue Software Cleaner"
        Width="1300" Height="800"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style x:Key="RiskHigh" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E53E3E" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="RiskMedium" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#D69E2E" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="RiskLow" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#38A169" />
    </Style>
  </Window.Resources>

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,6" Padding="6" CornerRadius="4">
      <StackPanel Orientation="Horizontal">
        <Button Content="刷新扫描" Command="{Binding ScanCommand}" IsEnabled="{Binding IsNotBusy}" MinWidth="100" />
        <Button Content="取消" Command="{Binding CancelCommand}" IsEnabled="{Binding IsScanning}" MinWidth="80" Margin="8,0,0,0" />
        <Separator Width="1" Margin="12,4" Background="#E2E8F0" />
        <Button Content="执行清理" Command="{Binding ExecuteCleanCommand}" IsEnabled="{Binding CanExecuteClean}" MinWidth="100" />
        <Button Content="导出计划" Command="{Binding ExportPlanCommand}" IsEnabled="{Binding CanExportPlan}" MinWidth="100" Style="{StaticResource ActionButton}" />
        <Button Content="导出报告" Command="{Binding ExportReportCommand}" IsEnabled="{Binding CanExportReport}" MinWidth="100" Style="{StaticResource ActionButton}" />
        <Separator Width="1" Margin="12,4" Background="#E2E8F0" />
        <CheckBox Content="全选" IsChecked="{Binding AllSelected}" IsThreeState="False" VerticalAlignment="Center" Margin="4,0" />
        <CheckBox Content="仅高风险" IsChecked="{Binding OnlyHighRisk}" Margin="8,0,4,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ScanProgress}" VerticalAlignment="Center" Margin="16,0,4,0" FontWeight="SemiBold" />
      </StackPanel>
    </Border>

    <!-- Tab pages -->
    <TabControl Grid.Row="1" SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}" BorderBrush="#E2E8F0" BorderThickness="1">
      <!-- 全部 -->
      <TabItem Header="全部">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
            <TextBlock Text="{Binding AllSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding AllItems}" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Extended" IsReadOnly="False"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    RowBackground="#FAFBFC" AlternatingRowBackground="White">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
              <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="72" IsReadOnly="True" />
              <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="80" IsReadOnly="True" />
              <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="200" IsReadOnly="True" />
              <DataGridTextColumn Header="厂商" Binding="{Binding Publisher}" Width="140" IsReadOnly="True" />
              <DataGridTextColumn Header="路径" Binding="{Binding TargetPath}" Width="280" IsReadOnly="True" />
              <DataGridTextColumn Header="建议" Binding="{Binding Action}" Width="80" IsReadOnly="True" />
              <DataGridTextColumn Header="可恢复" Binding="{Binding IsRecoverableStr}" Width="60" IsReadOnly="True" />
              <DataGridTextColumn Header="原因" Binding="{Binding Reasons}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- 进程 -->
      <TabItem Header="进程">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
            <TextBlock Text="{Binding ProcessSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding ProcessItems}" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Extended" IsReadOnly="False"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
              <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="72" IsReadOnly="True" />
              <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="220" IsReadOnly="True" />
              <DataGridTextColumn Header="厂商" Binding="{Binding Publisher}" Width="160" IsReadOnly="True" />
              <DataGridTextColumn Header="路径" Binding="{Binding TargetPath}" Width="360" IsReadOnly="True" />
              <DataGridTextColumn Header="建议" Binding="{Binding Action}" Width="80" IsReadOnly="True" />
              <DataGridTextColumn Header="原因" Binding="{Binding Reasons}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,6,4,0">
            <Button Content="停止选中进程" Command="{Binding ExecuteCleanCommand}" IsEnabled="{Binding CanExecuteClean}" Style="{StaticResource ActionButton}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- 启动项 -->
      <TabItem Header="启动项">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
            <TextBlock Text="{Binding StartupSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding StartupItems}" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Extended" IsReadOnly="False"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
              <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="72" IsReadOnly="True" />
              <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="80" IsReadOnly="True" />
              <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="200" IsReadOnly="True" />
              <DataGridTextColumn Header="厂商" Binding="{Binding Publisher}" Width="140" IsReadOnly="True" />
              <DataGridTextColumn Header="路径" Binding="{Binding TargetPath}" Width="320" IsReadOnly="True" />
              <DataGridTextColumn Header="建议" Binding="{Binding Action}" Width="80" IsReadOnly="True" />
              <DataGridTextColumn Header="原因" Binding="{Binding Reasons}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,6,4,0">
            <Button Content="禁用选中启动项" Command="{Binding ExecuteCleanCommand}" IsEnabled="{Binding CanExecuteClean}" Style="{StaticResource ActionButton}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- 服务 -->
      <TabItem Header="服务">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
            <TextBlock Text="{Binding ServiceSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding ServiceItems}" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Extended" IsReadOnly="False"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
              <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="72" IsReadOnly="True" />
              <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="260" IsReadOnly="True" />
              <DataGridTextColumn Header="路径" Binding="{Binding TargetPath}" Width="360" IsReadOnly="True" />
              <DataGridTextColumn Header="信息" Binding="{Binding CommandLine}" Width="180" IsReadOnly="True" />
              <DataGridTextColumn Header="建议" Binding="{Binding Action}" Width="80" IsReadOnly="True" />
              <DataGridTextColumn Header="原因" Binding="{Binding Reasons}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,6,4,0">
            <Button Content="禁用选中服务" Command="{Binding ExecuteCleanCommand}" IsEnabled="{Binding CanExecuteClean}" Style="{StaticResource ActionButton}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- 计划任务 -->
      <TabItem Header="计划任务">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
            <TextBlock Text="{Binding TaskSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding TaskItems}" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Extended" IsReadOnly="False"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
              <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="72" IsReadOnly="True" />
              <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="300" IsReadOnly="True" />
              <DataGridTextColumn Header="路径" Binding="{Binding TargetPath}" Width="360" IsReadOnly="True" />
              <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="140" IsReadOnly="True" />
              <DataGridTextColumn Header="建议" Binding="{Binding Action}" Width="80" IsReadOnly="True" />
              <DataGridTextColumn Header="原因" Binding="{Binding Reasons}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,6,4,0">
            <Button Content="禁用选中任务" Command="{Binding ExecuteCleanCommand}" IsEnabled="{Binding CanExecuteClean}" Style="{StaticResource ActionButton}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- 安装程序 -->
      <TabItem Header="安装程序">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DataGrid Grid.Row="0" ItemsSource="{Binding ProgramItems}" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Extended" IsReadOnly="False"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
              <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="72" IsReadOnly="True" />
              <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="300" IsReadOnly="True" />
              <DataGridTextColumn Header="厂商" Binding="{Binding Publisher}" Width="200" IsReadOnly="True" />
              <DataGridTextColumn Header="安装位置" Binding="{Binding TargetPath}" Width="320" IsReadOnly="True" />
              <DataGridTextColumn Header="建议" Binding="{Binding Action}" Width="80" IsReadOnly="True" />
              <DataGridTextColumn Header="原因" Binding="{Binding Reasons}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- 快捷方式 -->
      <TabItem Header="快捷方式">
        <DataGrid ItemsSource="{Binding ShortcutItems}" AutoGenerateColumns="False"
                  CanUserAddRows="False" SelectionMode="Extended" IsReadOnly="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
            <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="72" IsReadOnly="True" />
            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="220" IsReadOnly="True" />
            <DataGridTextColumn Header="目标" Binding="{Binding TargetPath}" Width="400" IsReadOnly="True" />
            <DataGridTextColumn Header="文件" Binding="{Binding CommandLine}" Width="360" IsReadOnly="True" />
            <DataGridTextColumn Header="建议" Binding="{Binding Action}" Width="80" IsReadOnly="True" />
            <DataGridTextColumn Header="原因" Binding="{Binding Reasons}" Width="*" IsReadOnly="True" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <!-- 隔离区 -->
      <TabItem Header="隔离区">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DataGrid Grid.Row="0" ItemsSource="{Binding QuarantineItems}"
                    AutoGenerateColumns="False" CanUserAddRows="False"
                    SelectionMode="Extended" IsReadOnly="False"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
              <DataGridTextColumn Header="时间" Binding="{Binding QuarantineTime}" Width="160" IsReadOnly="True" />
              <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100" IsReadOnly="True" />
              <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="72" IsReadOnly="True" />
              <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="200" IsReadOnly="True" />
              <DataGridTextColumn Header="原位置" Binding="{Binding OriginalLocation}" Width="320" IsReadOnly="True" />
              <DataGridTextColumn Header="还原方式" Binding="{Binding RestoreHint}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,6,4,0">
            <Button Content="还原选中" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" Style="{StaticResource ActionButton}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- 报告 -->
      <TabItem Header="报告">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
            <Button Content="刷新报告列表" Command="{Binding RefreshReportsCommand}" Style="{StaticResource ActionButton}" />
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding ReportFiles}" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Single" IsReadOnly="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="300" />
              <DataGridTextColumn Header="大小" Binding="{Binding SizeStr}" Width="80" />
              <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedStr}" Width="160" />
              <DataGridTextColumn Header="路径" Binding="{Binding FullPath}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Status bar -->
    <DockPanel Grid.Row="2" Margin="0,6,0,0">
      <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" VerticalAlignment="Center" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock Text="{Binding TotalSummaryText}" VerticalAlignment="Center" />
        <Separator Width="1" Margin="8,2" Background="#CBD5E0" />
        <TextBlock Text="{Binding AdminStatusText}" VerticalAlignment="Center" Foreground="#718096" Margin="4,0" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
